{
  "uid": "segsoft-backend",
  "title": "SegSoft - Backend",
  "tags": [
    "segsoft"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Métricas de /actuator/prometheus: análisis, ejecución de reglas en el motor Python, API HTTP y JVM.",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Análisis",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Análisis en ejecución",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "sum(analyses_running_current{job=\"segsoft-backend\"})",
          "legendFormat": "en ejecución"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "analyses_running_current: análisis corriendo ahora en el backend."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Análisis terminados desde el arranque",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "sum by (status) (analyses_executed_total{job=\"segsoft-backend\"})",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "analyses_executed_total por estado final."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errores de reglas desde el arranque",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "sum(rule_execution_errors_total{job=\"segsoft-backend\"}) or vector(0)",
          "legendFormat": "errores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "description": "rule_execution_errors_total: errores que reportó el motor o fallos al llamarlo."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Análisis terminados por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "sum by (status) (increase(analyses_executed_total{job=\"segsoft-backend\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores de reglas por código",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "sum by (errorCode, ruleType) (increase(rule_execution_errors_total{job=\"segsoft-backend\"}[$__rate_interval]))",
          "legendFormat": "{{errorCode}} · {{ruleType}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "RULE_TIMEOUT, ENGINE_ERROR (motor caído o sin responder), PATH_OUTSIDE_SANDBOX, etc."
    },
    {
      "id": 101,
      "type": "row",
      "title": "Motor Python",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Duración p95 de una ejecución de regla, por tipo",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, ruleType) (rate(rule_execution_duration_seconds_bucket{job=\"segsoft-backend\"}[$__rate_interval])))",
          "legendFormat": "p95 {{ruleType}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "rule_execution_duration_seconds: cada petición al motor (una regla sobre un lote de archivos). Un tipo de regla que sube aquí es el cuello de botella."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duración media por tipo de regla",
      "datasource": {
        "type": "prometheus",
        "uid": "segsoft-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "segsoft-prometheus"
          },
          "expr": "sum by (ruleType) (rate(rule_execution_duration_seconds_sum{job=\"segsoft-backend\"}[$__rate_interval])) / sum by (ruleType) (rate(rule_execution_duration_seconds_count{job=\"segsoft-backend\"}[$__rate_interval]))",
          "legendFormat": "media {{ruleType}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
