<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!--
    One JSON object per line:
      {"timestamp":"2026-11-12T15:04:05.123Z","level":"ERROR","traceId":"…","message":"…",
       "logger":"co.icesi.pdgseg…","context":{"service":"pdgseg-backend","thread":"…"},"stackTrace":"…"}
    timestamp is ISO-8601 in UTC. traceId is the request's (TraceIdFilter), the same one the
    client gets in X-Trace-Id and in error bodies; it is absent outside a request (startup).
    Every string value goes through SecretLogValueMasker first, stack traces included.
  -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
        <valueMasker class="co.icesi.pdgseg.observability.SecretLogValueMasker"/>
        <!-- Fields that are always secret, whatever their value looks like. -->
        <path>password</path>
        <path>authorization</path>
        <path>token</path>
      </jsonGeneratorDecorator>
      <providers>
        <timestamp>
          <fieldName>timestamp</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSX</pattern>
          <timeZone>UTC</timeZone>
        </timestamp>
        <logLevel>
          <fieldName>level</fieldName>
        </logLevel>
        <mdc>
          <includeMdcKeyName>traceId</includeMdcKeyName>
        </mdc>
        <message>
          <fieldName>message</fieldName>
        </message>
        <loggerName>
          <fieldName>logger</fieldName>
        </loggerName>
        <nestedField>
          <fieldName>context</fieldName>
          <providers>
            <pattern>
              <pattern>{"service":"pdgseg-backend"}</pattern>
            </pattern>
            <threadName>
              <fieldName>thread</fieldName>
            </threadName>
            <mdc>
              <excludeMdcKeyName>traceId</excludeMdcKeyName>
            </mdc>
          </providers>
        </nestedField>
        <stackTrace>
          <fieldName>stackTrace</fieldName>
        </stackTrace>
      </providers>
    </encoder>
  </appender>

  <springProfile name="!test">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="test">
    <root level="WARN">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <logger name="co.icesi.pdgseg" level="INFO"/>
  <logger name="org.flywaydb" level="INFO"/>
  <logger name="org.springframework.security" level="WARN"/>
  <logger name="org.hibernate.SQL" level="WARN"/>

</configuration>
