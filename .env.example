# Base de datos PostgreSQL
DB_POSTGRES_DB=pdgseg
DB_POSTGRES_USER=pdgseg
DB_POSTGRES_PASSWORD=changeme

# Conexión Spring → PostgreSQL (usa el nombre del servicio docker)
DB_URL=jdbc:postgresql://db:5432/pdgseg
DB_USER=pdgseg
DB_PASSWORD=changeme

# JWT
JWT_SECRET=your-secret-key-minimum-32-characters-here

# Motor Python (nombre del servicio docker)
ENGINE_BASE_URL=http://engine-python:8001
INTERNAL_SERVICE_TOKEN=dev-internal-token

# CORS (URL del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173
